server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    # font/woff2 уже есть в /etc/nginx/mime.types начиная с nginx 1.19.7 —
    # свой types{} тут не нужен: он бы ЗАМЕНИЛ всю таблицу, а не дополнил.

    gzip on;
    gzip_types text/css application/javascript image/svg+xml font/woff2;

    # /ready → mysun/ready.html без .html в адресе
    location = /ready {
        try_files /ready.html =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
